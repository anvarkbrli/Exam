@model LoginVM
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="az">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Login</title>

    <link rel="stylesheet" href="~/assets/login.css">
</head>
<body>

    <div class="login-page">
        <div class="login-card">
            <div class="login-header">
                <h1>Xoş Gəlmişsiniz</h1>
                <p>Hesabına daxil ol</p>
            </div>
            <div asp-validation-summary="ModelOnly" style="color:red"></div>
            <form class="login-form" method="post">
                <div class="form-group">
                    <label for="UsernameOrEmail">Email ve ya Istifadeci adi</label>
                    <input asp-for="UsernameOrEmail" placeholder="Email ünvanınızı və ya İstifadəçi adınızı daxil edin">
                    <span asp-validation-for="UsernameOrEmail" style="color:red"></span>
                </div>

                <div class="form-group">
                    <label for="Password">Şifrə</label>
                    <input asp-for="Password" placeholder="Şifrənizi daxil edin" />
                    <span asp-validation-for ="UsernameOrEmail" style="color:red"></span>
                </div>

                <div class="form-options">
                    <label class="remember">
                        <input asp-for="IsPersistent">
                        <span asp-validation-for="IsPersistent" >Məni yadda saxla</span>
                    </label>

                </div>

                <button type="submit" class="login-btn">Daxil ol</button>
            </form>

            <div class="login-footer">
                <p>Hesabın yoxdur?</p>
                <a asp-action="Register">Qeydiyyatdan keç</a>
            </div>
        </div>
    </div>

</body>
</html>