@model List<GetVM>
@{
    int count = 0;
}
<div class="col-lg-12 grid-margin stretch-card">
    <div class="card">
        <div class="card-body">
            <h4 class="card-title">Collection Table</h4>
            <a class="btn btn-success" asp-action="Create">Create</a>
            <div class="table-responsive">
                <table class="table table-striped">
                    <thead>
                        <tr>
                            <th>
                                No
                            </th>
                            <th>
                                Image
                            </th>
                            <th>
                                Name
                            </th>
                            <th>
                                Stock
                            </th>
                            <th>
                                Category
                            </th>
                            <th>
                                Actions
                            </th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (GetVM collection in Model)
                        {
                            <tr>
                                <td>
                                    @(++count)
                                </td>
                                <td class="py-1">
                                    <img src="~/assets/images/@collection.Image" alt="image" />
                                </td>
                                <td>
                                    @collection.Name
                                </td>
                                <td>
                                    @collection.Stock
                                </td>
                                <td>
                                    @collection.Category
                                </td>
                                <td>
                                    <a class="btn btn-warning" asp-action="Update" asp-route-id="@collection.Id">Update</a>
                                    <a class="btn btn-danger" asp-action="Delete" asp-route-id="@collection.Id">Delete</a>
                                    <a class="btn btn-info" asp-action="Details" asp-route-id="@collection.Id">Details</a>

                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>